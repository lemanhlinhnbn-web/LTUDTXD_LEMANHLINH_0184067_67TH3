<Window x:Class="LTUDTXD_HUCE_01_LEMANHLINH_0318867_67TH3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:LTUDTXD_HUCE_01_LEMANHLINH_0318867_67TH3.ViewModels"
        xmlns:views="clr-namespace:LTUDTXD_HUCE_01_LEMANHLINH_0318867_67TH3.Views"
        mc:Ignorable="d"
        Title="{Binding ProjectName}"
        Height="780"
        Width="1240"
        MinHeight="700"
        MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Icon="Assets/logo-steel-check.ico"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,4,6,4" />
            <Setter Property="Background" Value="#17191F" />
            <Setter Property="Foreground" Value="#EAF3FF" />
            <Setter Property="BorderBrush" Value="#30333C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#292C34" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#20C9B0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#176E63" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
            <Setter Property="Margin" Value="0,4,12,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D92D20" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#D92D20" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#B42318" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#B42318" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnimatedPageHostStyle" TargetType="ContentControl">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <TranslateTransform X="0" Y="0" />
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.28"
                                             DecelerationRatio="0.85" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                             From="18"
                                             To="0"
                                             Duration="0:0:0.28"
                                             DecelerationRatio="0.85" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                             From="0.985" To="1"
                                             Duration="0:0:0.3"
                                             DecelerationRatio="0.85" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                             From="0.985" To="1"
                                             Duration="0:0:0.3"
                                             DecelerationRatio="0.85" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.24"
                                             DecelerationRatio="0.9" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                             From="16"
                                             To="0"
                                             Duration="0:0:0.24"
                                             DecelerationRatio="0.9" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                             From="0.988" To="1"
                                             Duration="0:0:0.26"
                                             DecelerationRatio="0.9" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                             From="0.988" To="1"
                                             Duration="0:0:0.26"
                                             DecelerationRatio="0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:EtabsSourceViewModel}">
            <views:EtabsSourceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BeamParametersViewModel}">
            <views:BeamParametersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BeamCheckViewModel}">
            <views:BeamCheckView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#15171D"
                BorderBrush="{StaticResource PanelLineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <Image Width="24"
                           Height="24"
                           Source="Assets/logo-steel-check.png"
                           Stretch="Uniform"
                           Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="TÍNH DẦM THÉP"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13.5"
                               FontWeight="SemiBold" />
                    <Border Background="#202229"
                            BorderBrush="#30333C"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,3"
                            Margin="12,0,0,0">
                        <TextBlock Text="TCVN 5575:2012"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="-"
                            Click="MinimizeButton_Click"
                            Style="{StaticResource ChromeButtonStyle}" />
                    <Button Content="□"
                            Click="MaximizeButton_Click"
                            Style="{StaticResource ChromeButtonStyle}" />
                    <Button Content="X"
                            Click="CloseButton_Click"
                            Style="{StaticResource ChromeCloseButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource RailBrush}">
                <Grid Margin="18,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="40"
                                   Height="40"
                                   Source="Assets/logo-steel-check.png"
                                   Stretch="Uniform"
                                   Margin="0,0,10,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel>
                                <TextBlock Text="TÍNH DẦM THÉP"
                                           Foreground="#FFFFFF"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="TCVN 5575:2012"
                                           Foreground="#9AA6B8"
                                           FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{StaticResource RailSoftBrush}"
                                BorderBrush="#3B4A55"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,20,0,18">
                            <StackPanel>
                                <TextBlock Text="MÔ HÌNH"
                                           Foreground="#8995A6"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StructureName}"
                                           Margin="0,7,0,3"
                                           Foreground="#FFFFFF"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding EtabsModelName}"
                                           Foreground="#A9B4C2"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{StaticResource WarningBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding LastSyncText}"
                                               Foreground="#D3DAE4"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="CÁC TAB"
                               Foreground="#8995A6"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             Style="{StaticResource NavigationListStyle}"
                             ItemContainerStyle="{StaticResource NavigationItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13.5" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11"
                                                   Opacity="0.72"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3"
                            Background="#202E39"
                            BorderBrush="#40515D"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding StudentInfo}"
                                       Foreground="#A9B4C2"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Dữ liệu ETABS, thông số dầm I, kiểm tra bền và ổn định."
                                       Margin="0,5,0,0"
                                       Foreground="#FFFFFF"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="92" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#101116"
                        BorderBrush="{StaticResource PanelLineBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="24,11">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#1B1D24"
                                    BorderBrush="#2D3038"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="11,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#7F8994"
                                               VerticalAlignment="Center"
                                               Margin="0,0,9,0" />
                                    <TextBlock Text="Tìm kiếm chức năng"
                                               Foreground="#7F8994"
                                               VerticalAlignment="Center"
                                               FontSize="12" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Trợ giúp"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="32"
                                        Padding="12,5"
                                        Margin="8,0" />
                                <Button Content="Lưu báo cáo"
                                        Command="{Binding SaveReportCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="32"
                                        Padding="12,5" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentPageViewModel.Title}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CurrentPageViewModel.Subtitle}"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#173F3B"
                                    BorderBrush="#20C9B0"
                                    BorderThickness="1"
                                    CornerRadius="13"
                                    Padding="10,4"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7"
                                             Height="7"
                                             Fill="#20C9B0"
                                             Margin="0,0,7,0"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever"
                                                                AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.45" To="1"
                                                                         Duration="0:0:0.85" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="0.8" To="1.15"
                                                                         Duration="0:0:0.85" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="0.8" To="1.15"
                                                                         Duration="0:0:0.85" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <TextBlock Text="Hệ thống sẵn sàng"
                                               Foreground="#71E7D5"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentPageViewModel, NotifyOnTargetUpdated=True}"
                                Style="{StaticResource AnimatedPageHostStyle}"
                                Margin="24,22,26,26" />
            </Grid>
        </Grid>
    </Grid>
</Window>
