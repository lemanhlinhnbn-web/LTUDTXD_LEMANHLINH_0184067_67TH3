<UserControl x:Class="LTUDTXD_HUCE_LEMANHLINH_0184067_67CNTH.Views.BeamCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="CheckResultTemplate">
            <Border Background="#15171D"
                    BorderBrush="{Binding StatusBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}" />
                            <TextBlock Text="{Binding Group}"
                                       Margin="0,2,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="{Binding UtilizationPercent, StringFormat={}{0:0.0}%}"
                                       Foreground="{Binding StatusBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextAlignment="Right" />
                            <Border Background="#101217"
                                    BorderBrush="{Binding StatusBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6,1"
                                    HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Status}"
                                           Foreground="{Binding StatusBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ProgressBar Height="5"
                                     Maximum="120"
                                     Value="{Binding UtilizationPercent}"
                                     Foreground="{Binding StatusBrush}" />
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Limit}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Limit}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentValue}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Note}"
                                       Margin="10,0,0,0" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,10">
                <Border Style="{StaticResource MetricCardStyle}" Padding="12" MinHeight="78" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Điều kiện bền" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Text="{Binding StrengthRatioText}"
                                   Margin="0,5,0,0"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StatusBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Padding="12" MinHeight="78" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Điều kiện ổn định" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Text="{Binding StabilityRatioText}"
                                   Margin="0,5,0,0"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StatusBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Padding="12" MinHeight="78">
                    <StackPanel>
                        <TextBlock Text="Điều kiện chi phối" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Text="{Binding GoverningCondition}"
                                   Margin="0,5,0,0"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StatusBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Chạy kiểm tra tổng hợp"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding Message}"
                                   Foreground="{Binding StatusBrush}"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding RunAllChecksCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="140"
                            Margin="18,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" Style="{StaticResource IconTextStyle}" />
                            <TextBlock Text="Kiểm tra" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="14">
                <StackPanel>
                    <TextBlock Text="Đặc trưng hình học tiết diện"
                               Style="{StaticResource SectionTitleStyle}" />
                    <UniformGrid Columns="4" Margin="0,8,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Diện tích A" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding Section.Area, StringFormat={}{0:0.##} mm²}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Ix" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding Section.Ix, StringFormat={}{0:0.##} mm⁴}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Wx" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding Section.Wx, StringFormat={}{0:0.##} mm³}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="iy" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding Section.RadiusY, StringFormat={}{0:0.##} mm}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Visibility="{Binding ResultsEmptyVisibility}"
                    Grid.Row="3"
                    Style="{StaticResource CardStyle}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,14">
                    <TextBlock Text="&#xE9F9;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="28"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Chưa có kết quả kiểm tra"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Bấm Kiểm tra để đồng bộ dầm đang chọn, tính đặc trưng tiết diện và đánh giá điều kiện bền, ổn định."
                               Style="{StaticResource CaptionStyle}"
                               TextAlignment="Center"
                               Margin="0,6,0,0"
                               MaxWidth="520" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Visibility="{Binding ResultsListVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Kiểm tra điều kiện bền"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding StrengthChecks}"
                                          ItemTemplate="{StaticResource CheckResultTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Kiểm tra điều kiện ổn định"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding StabilityChecks}"
                                          ItemTemplate="{StaticResource CheckResultTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
    </Grid>
</UserControl>
