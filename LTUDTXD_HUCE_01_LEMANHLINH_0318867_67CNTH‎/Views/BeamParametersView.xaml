<UserControl x:Class="LTUDTXD_HUCE_LEMANHLINH_0184067_67CNTH.Views.BeamParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="InputLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#15171D" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Background" Value="#17211F" />
                </Trigger>
                <EventTrigger RoutedEvent="GotKeyboardFocus">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.012" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.012" Duration="0:0:0.14" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="LostKeyboardFocus">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#15171D" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#25312F" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#176E63" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#15171D" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource InputComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False" />

                                    <TextBox x:Name="PART_EditableTextBox"
                                             Margin="{TemplateBinding Padding}"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent"
                                             Foreground="{TemplateBinding Foreground}"
                                             BorderThickness="0"
                                             Visibility="Hidden" />

                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                        <Path Width="9"
                                              Height="5"
                                              Fill="#9BA5AF"
                                              Stretch="Fill"
                                              Data="M 0 0 L 4.5 5 L 9 0 Z" />
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,3,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240"
                                        Background="#15171D"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="OuterBorder" Property="Background" Value="#17211F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <Grid MinWidth="860">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Hình học tiết diện I" Style="{StaticResource SectionTitleStyle}" />
                        <Border Background="#15171D"
                                BorderBrush="{StaticResource PanelLineBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10"
                                Margin="0,12,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="{Binding SelectedFrameText}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectedFrameText}" />
                                    <TextBlock Text="{Binding SaveMessage}"
                                               Margin="0,3,0,0"
                                               Style="{StaticResource CaptionStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SaveMessage}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding SaveForSelectedFrameCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="34"
                                        MinWidth="132"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource IconTextStyle}" />
                                        <TextBlock Text="Lưu cho dầm này" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <UniformGrid Columns="2" Margin="0,0,0,0">
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="Chiều cao tiết diện h (mm)" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding Input.Height, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Bề rộng cánh b (mm)" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding Input.FlangeWidth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="Chiều dày bụng tw (mm)" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding Input.WebThickness, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Chiều dày cánh tf (mm)" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding Input.FlangeThickness, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Nhịp tính toán L (m)" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding Input.SpanLength, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBoxStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Chiều dài không giằng Lb (m)" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding Input.UnbracedLength, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBoxStyle}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Vật liệu và nội lực thiết kế" Style="{StaticResource SectionTitleStyle}" />
                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="Mác thép" Style="{StaticResource InputLabelStyle}" />
                                <ComboBox ItemsSource="{Binding SteelGrades}"
                                          IsEditable="True"
                                          Text="{Binding Input.SteelGrade, UpdateSourceTrigger=PropertyChanged}"
                                          IsTextSearchEnabled="False"
                                          Style="{StaticResource InputComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Cường độ Ry (MPa)" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding Input.DesignStrength, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="Mô men Mx (kN.m)" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding Input.DesignMoment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Lực cắt V (kN)" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding Input.DesignShear, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Hệ số điều kiện làm việc γc" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding Input.WorkingConditionFactor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBoxStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Hệ số ổn định tổng thể φb" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding Input.LateralTorsionalBucklingFactor, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Nhập φb xác định theo TCVN 2275:2024 cho sơ đồ dầm đang xét."
                                         Style="{StaticResource InputBoxStyle}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                    <TextBlock Text="Sơ đồ tiết diện dầm chữ I"
                               Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Ký hiệu hình học sử dụng trong tính toán"
                               Margin="0,3,0,10"
                               Style="{StaticResource CaptionStyle}" />

                    <Border Height="235"
                            Background="#111318"
                            BorderBrush="{StaticResource PanelLineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,14">
                        <Viewbox Stretch="Uniform" Margin="12">
                            <Canvas Width="350" Height="250">
                                <Rectangle Canvas.Left="104"
                                           Canvas.Top="34"
                                           Width="142"
                                           Height="32"
                                           Fill="#2C3B47"
                                           Stroke="#8FA1B2"
                                           StrokeThickness="2" />
                                <Rectangle Canvas.Left="159"
                                           Canvas.Top="64"
                                           Width="32"
                                           Height="122"
                                           Fill="#2C3B47"
                                           Stroke="#8FA1B2"
                                           StrokeThickness="2" />
                                <Rectangle Canvas.Left="104"
                                           Canvas.Top="184"
                                           Width="142"
                                           Height="32"
                                           Fill="#2C3B47"
                                           Stroke="#8FA1B2"
                                           StrokeThickness="2" />

                                <Line X1="118" Y1="50" X2="232" Y2="50"
                                      Stroke="#5D7486"
                                      StrokeThickness="1"
                                      StrokeDashArray="4 4" />
                                <Line X1="118" Y1="200" X2="232" Y2="200"
                                      Stroke="#5D7486"
                                      StrokeThickness="1"
                                      StrokeDashArray="4 4" />
                                <Line X1="175" Y1="78" X2="175" Y2="172"
                                      Stroke="#5D7486"
                                      StrokeThickness="1"
                                      StrokeDashArray="4 4" />

                                <Rectangle Canvas.Left="105"
                                           Canvas.Top="35"
                                           Width="140"
                                           Height="30"
                                           Fill="#476175"
                                           Opacity="0.55" />
                                <Rectangle Canvas.Left="105"
                                           Canvas.Top="185"
                                           Width="140"
                                           Height="30"
                                           Fill="#476175"
                                           Opacity="0.55" />
                                <Rectangle Canvas.Left="160"
                                           Canvas.Top="65"
                                           Width="30"
                                           Height="120"
                                           Fill="#20C9B0"
                                           Opacity="0.22" />

                                <!-- Kích thước h -->
                                <Line X1="75" Y1="35" X2="75" Y2="215"
                                      Stroke="#20C9B0" StrokeThickness="1.5" />
                                <Line X1="68" Y1="35" X2="88" Y2="35"
                                      Stroke="#20C9B0" StrokeThickness="1.5" />
                                <Line X1="68" Y1="215" X2="88" Y2="215"
                                      Stroke="#20C9B0" StrokeThickness="1.5" />
                                <Path Fill="#20C9B0" Data="M75,35 L70,44 L80,44 Z" />
                                <Path Fill="#20C9B0" Data="M75,215 L70,206 L80,206 Z" />
                                <Border Canvas.Left="38"
                                        Canvas.Top="112"
                                        Background="#173F3B"
                                        CornerRadius="4"
                                        Padding="6,3">
                                    <StackPanel>
                                        <TextBlock Text="h"
                                                   Foreground="#71E7D5"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Input.Height, StringFormat={}{0:0.#} mm}"
                                                   Foreground="#A7FFF3"
                                                   FontSize="9"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <!-- Kích thước b -->
                                <Line X1="105" Y1="17" X2="245" Y2="17"
                                      Stroke="#20C9B0" StrokeThickness="1.5" />
                                <Line X1="105" Y1="10" X2="105" Y2="29"
                                      Stroke="#20C9B0" StrokeThickness="1.5" />
                                <Line X1="245" Y1="10" X2="245" Y2="29"
                                      Stroke="#20C9B0" StrokeThickness="1.5" />
                                <Path Fill="#20C9B0" Data="M105,17 L114,12 L114,22 Z" />
                                <Path Fill="#20C9B0" Data="M245,17 L236,12 L236,22 Z" />
                                <Border Canvas.Left="164"
                                        Canvas.Top="2"
                                        Background="#173F3B"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="b"
                                                   Foreground="#71E7D5"
                                                   FontSize="14"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding Input.FlangeWidth, StringFormat=' = {0:0.#} mm'}"
                                                   Foreground="#A7FFF3"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="4,1,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Kích thước tf -->
                                <Line X1="270" Y1="35" X2="270" Y2="65"
                                      Stroke="#F59E0B" StrokeThickness="1.5" />
                                <Line X1="245" Y1="35" X2="278" Y2="35"
                                      Stroke="#F59E0B" StrokeThickness="1.5" />
                                <Line X1="245" Y1="65" X2="278" Y2="65"
                                      Stroke="#F59E0B" StrokeThickness="1.5" />
                                <Path Fill="#F59E0B" Data="M270,35 L266,43 L274,43 Z" />
                                <Path Fill="#F59E0B" Data="M270,65 L266,57 L274,57 Z" />
                                <Border Canvas.Left="280"
                                        Canvas.Top="38"
                                        Background="#4A3510"
                                        CornerRadius="4"
                                        Padding="6,3">
                                    <StackPanel>
                                        <TextBlock Text="tf"
                                                   Foreground="#FBBF55"
                                                   FontSize="14"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding Input.FlangeThickness, StringFormat={}{0:0.#} mm}"
                                                   Foreground="#FFE2A8"
                                                   FontSize="9"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <!-- Kích thước tw -->
                                <Line X1="160" Y1="143" X2="190" Y2="143"
                                      Stroke="#F59E0B" StrokeThickness="1.5" />
                                <Line X1="160" Y1="134" X2="160" Y2="153"
                                      Stroke="#F59E0B" StrokeThickness="1.5" />
                                <Line X1="190" Y1="134" X2="190" Y2="153"
                                      Stroke="#F59E0B" StrokeThickness="1.5" />
                                <Path Fill="#F59E0B" Data="M160,143 L168,139 L168,147 Z" />
                                <Path Fill="#F59E0B" Data="M190,143 L182,139 L182,147 Z" />
                                <Border Canvas.Left="199"
                                        Canvas.Top="130"
                                        Background="#4A3510"
                                        CornerRadius="4"
                                        Padding="6,3">
                                    <StackPanel>
                                        <TextBlock Text="tw"
                                                   Foreground="#FBBF55"
                                                   FontSize="14"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding Input.WebThickness, StringFormat={}{0:0.#} mm}"
                                                   Foreground="#FFE2A8"
                                                   FontSize="9"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <!-- Chú thích -->
                                <StackPanel Canvas.Left="270" Canvas.Top="180">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Rectangle Width="10" Height="10"
                                                   Fill="#476175"
                                                   Margin="0,0,7,0" />
                                        <TextBlock Text="Bản cánh"
                                                   Foreground="#A9B4C2"
                                                   FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="10" Height="10"
                                                   Fill="#20C9B0"
                                                   Opacity="0.7"
                                                   Margin="0,0,7,0" />
                                        <TextBlock Text="Bản bụng"
                                                   Foreground="#A9B4C2"
                                                   FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Bảng thông số đang dùng" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Các giá trị mẫu có thể chỉnh trực tiếp trong ô nhập để phục vụ kiểm tra dầm chữ I."
                                   Margin="0,3,0,0"
                                   Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Parameters}"
                              Grid.Row="2"
                              MinHeight="168"
                              MaxHeight="220"
                              Style="{StaticResource CompactDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nhóm" Binding="{Binding Group}" Width="96" />
                            <DataGridTextColumn Header="Ký hiệu" Binding="{Binding Symbol}" Width="78" />
                            <DataGridTextColumn Header="Giá trị" Binding="{Binding Value}" Width="86" />
                            <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="72" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
