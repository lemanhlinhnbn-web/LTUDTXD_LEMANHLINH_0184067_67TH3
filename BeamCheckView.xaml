<UserControl x:Class="LTUDTXD_HUCE_01_LEMANHLINH_0318867_67TH3.Views.BeamCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CheckPanelStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="FormulaBoxStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Background" Value="#15171D" />
            <Setter Property="BorderBrush" Value="#2A2D36" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>

        <Style x:Key="ConditionTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FormulaTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <UniformGrid Columns="3" Margin="0,0,0,18">
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Điều kiện bền" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Text="η = 0.88"
                                   Margin="0,8,0,0"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="uốn và cắt đồng thời" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Điều kiện ổn định" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Text="η = 0.78"
                                   Margin="0,8,0,0"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="ổn định uốn xoắn" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Độ mảnh" Style="{StaticResource CaptionStyle}" />
                        <TextBlock Text="λ = 58"
                                   Margin="0,8,0,0"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="giới hạn λ &lt;= 120" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Chạy kiểm tra tổng hợp" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Một nút dùng để kiểm tra điều kiện bền, điều kiện ổn định và độ mảnh."
                                   Margin="0,4,0,0"
                                   Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding RunStrengthCheckCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Center"
                            MinWidth="128"
                            Margin="18,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE9F9;" Style="{StaticResource IconTextStyle}" />
                            <TextBlock Text="Kiểm tra" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Style="{StaticResource CheckPanelStyle}">
                <StackPanel>
                        <TextBlock Text="Điều kiện bền" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Kiểm tra ứng suất pháp do mô men uốn, ứng suất tiếp do lực cắt và điều kiện tổ hợp."
                                   Margin="0,4,0,0"
                                   Style="{StaticResource CaptionStyle}" />

                        <UniformGrid Columns="3" Margin="0,4,0,0">
                            <Border Style="{StaticResource FormulaBoxStyle}" Margin="0,14,10,0">
                                <StackPanel>
                                    <TextBlock Text="Bền uốn" Style="{StaticResource ConditionTextStyle}" />
                                    <TextBlock Text="M / (Wn.Ry.γc) = 0.86" Style="{StaticResource FormulaTextStyle}" />
                                    <TextBlock Text="Yêu cầu: ≤ 1.00" Margin="0,8,0,0" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FormulaBoxStyle}" Margin="0,14,10,0">
                                <StackPanel>
                                    <TextBlock Text="Bền cắt" Style="{StaticResource ConditionTextStyle}" />
                                    <TextBlock Text="τ / Rs = 0.62" Style="{StaticResource FormulaTextStyle}" />
                                    <TextBlock Text="Yêu cầu: ≤ 1.00" Margin="0,8,0,0" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FormulaBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Uốn + cắt" Style="{StaticResource ConditionTextStyle}" />
                                    <TextBlock Text="η = 0.88" Style="{StaticResource FormulaTextStyle}" />
                                    <TextBlock Text="Trạng thái: theo dõi" Margin="0,8,0,0" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
            </Border>

            <Border Style="{StaticResource CheckPanelStyle}">
                <StackPanel>
                        <TextBlock Text="Điều kiện ổn định" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Kiểm tra ổn định tổng thể của dầm chữ I và ổn định cục bộ bản cánh, bản bụng."
                                   Margin="0,4,0,0"
                                   Style="{StaticResource CaptionStyle}" />

                        <UniformGrid Columns="3" Margin="0,4,0,0">
                            <Border Style="{StaticResource FormulaBoxStyle}" Margin="0,14,10,0">
                                <StackPanel>
                                    <TextBlock Text="Ổn định uốn xoắn" Style="{StaticResource ConditionTextStyle}" />
                                    <TextBlock Text="M / (φb.Mb) = 0.78" Style="{StaticResource FormulaTextStyle}" />
                                    <TextBlock Text="Yêu cầu: ≤ 1.00" Margin="0,8,0,0" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FormulaBoxStyle}" Margin="0,14,10,0">
                                <StackPanel>
                                    <TextBlock Text="Cục bộ cánh nén" Style="{StaticResource ConditionTextStyle}" />
                                    <TextBlock Text="b / tf = 8.33" Style="{StaticResource FormulaTextStyle}" />
                                    <TextBlock Text="So với giới hạn TCVN 5575" Margin="0,8,0,0" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FormulaBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Cục bộ bản bụng" Style="{StaticResource ConditionTextStyle}" />
                                    <TextBlock Text="hw / tw = 53.25" Style="{StaticResource FormulaTextStyle}" />
                                    <TextBlock Text="Trạng thái: đạt" Margin="0,8,0,0" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
            </Border>

            <Border Style="{StaticResource CheckPanelStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Độ mảnh" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Kiểm tra độ mảnh cấu kiện theo chiều dài tính toán và bán kính quán tính nhỏ nhất."
                               Margin="0,4,0,0"
                               Style="{StaticResource CaptionStyle}" />

                    <UniformGrid Columns="3" Margin="0,4,0,0">
                        <Border Style="{StaticResource FormulaBoxStyle}" Margin="0,14,10,0">
                            <StackPanel>
                                <TextBlock Text="Theo trục x" Style="{StaticResource ConditionTextStyle}" />
                                <TextBlock Text="λx = L0x / ix = 42" Style="{StaticResource FormulaTextStyle}" />
                                <TextBlock Text="Yêu cầu: λx ≤ 120" Margin="0,8,0,0" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FormulaBoxStyle}" Margin="0,14,10,0">
                            <StackPanel>
                                <TextBlock Text="Theo trục y" Style="{StaticResource ConditionTextStyle}" />
                                <TextBlock Text="λy = L0y / iy = 58" Style="{StaticResource FormulaTextStyle}" />
                                <TextBlock Text="Yêu cầu: λy ≤ 120" Margin="0,8,0,0" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FormulaBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Kết luận" Style="{StaticResource ConditionTextStyle}" />
                                <TextBlock Text="Đạt" Style="{StaticResource FormulaTextStyle}" />
                                <TextBlock Text="Độ mảnh nằm trong giới hạn cho phép." Margin="0,8,0,0" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
