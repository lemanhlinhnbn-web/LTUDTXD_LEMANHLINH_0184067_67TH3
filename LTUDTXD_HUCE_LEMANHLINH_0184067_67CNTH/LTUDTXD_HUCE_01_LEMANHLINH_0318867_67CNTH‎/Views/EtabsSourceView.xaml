<UserControl x:Class="LTUDTXD_HUCE_LEMANHLINH_0184067_67CNTH.Views.EtabsSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="AnimatedBarStyle" TargetType="Border">
            <Setter Property="Width" Value="50" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="RenderTransformOrigin" Value="0.5,1" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.25" To="1"
                                             Duration="0:0:0.42" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="0" To="1"
                                             Duration="0:0:0.52"
                                             DecelerationRatio="0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.035" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FrameGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202229" />
            <Setter Property="Foreground" Value="#C9CFD5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="FrameGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="#101217" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#15171D" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B2D31" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#173F3B" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FrameGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="FrameLengthTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="220" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nguồn nội lực từ ETABS" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding Summary}"
                                       Margin="0,3,0,0"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="14"
                                Padding="11,5"
                                VerticalAlignment="Top">
                            <TextBlock Text="ETABS"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#15171D"
                            BorderBrush="{StaticResource PanelLineBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Danh sách dầm trong ETABS"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Chọn một dầm trong bảng này trước khi đọc nội lực hoặc kiểm tra."
                                               Margin="0,3,0,0"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{StaticResource PrimarySoftBrush}"
                                        BorderBrush="#235E56"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Padding="10,4"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding FrameCountText}"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                                <Button Grid.Column="2"
                                        Command="{Binding LoadFrameListCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="124"
                                        Height="34"
                                        Padding="11,6"
                                        Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconTextStyle}" />
                                        <TextBlock Text="Tải danh sách" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Grid.Row="1"
                                    Background="#101217"
                                    BorderBrush="{StaticResource PanelLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <DataGrid ItemsSource="{Binding Frames}"
                                              SelectedItem="{Binding SelectedFrame, Mode=TwoWay}"
                                              Visibility="{Binding FrameGridVisibility}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              Background="#101217"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              BorderThickness="0"
                                              HorizontalGridLinesBrush="#242832"
                                              RowBackground="#101217"
                                              AlternatingRowBackground="#15171D"
                                              AlternationCount="2"
                                              ColumnHeaderStyle="{StaticResource FrameGridColumnHeaderStyle}"
                                              RowStyle="{StaticResource FrameGridRowStyle}"
                                              CellStyle="{StaticResource FrameGridCellStyle}"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="False"
                                              CanUserResizeRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tên dầm"
                                                                Binding="{Binding Name}"
                                                                Width="1.35*" />
                                            <DataGridTextColumn Header="Tiết diện"
                                                                Binding="{Binding SectionName}"
                                                                Width="*" />
                                            <DataGridTextColumn Header="L (m)"
                                                                Binding="{Binding SpanLengthText}"
                                                                ElementStyle="{StaticResource FrameLengthTextStyle}"
                                                                Width="86" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Visibility="{Binding FrameEmptyVisibility}"
                                            Background="#101217"
                                            CornerRadius="6">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8B7;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="24"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,8" />
                                            <TextBlock Text="Chưa có danh sách dầm"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Bấm Tải danh sách sau khi kết nối ETABS."
                                                       Margin="0,4,0,0"
                                                       Style="{StaticResource CaptionStyle}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="#101217"
                            BorderBrush="{StaticResource PanelLineBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Biểu đồ nội lực M - V - Q"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Đường biểu đồ lấy theo station dọc dầm của tổ hợp chi phối."
                                               Margin="0,3,0,0"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{Binding InternalForceDiagrams}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                                <Border Width="18"
                                                        Height="4"
                                                        Background="{Binding Stroke}"
                                                        CornerRadius="2"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="#EAFBFA"
                                    BorderBrush="#9AB7B8"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    ClipToBounds="True">
                                <Viewbox Stretch="Uniform"
                                         StretchDirection="DownOnly"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch">
                                    <Canvas Width="620" Height="300" ClipToBounds="True">
                                        <Line X1="66" Y1="38" X2="520" Y2="38"
                                              Stroke="#111827" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Line X1="66" Y1="28" X2="66" Y2="266"
                                              Stroke="#111827" StrokeThickness="1.5" StrokeDashArray="6 4" />
                                        <Line X1="520" Y1="28" X2="520" Y2="266"
                                              Stroke="#111827" StrokeThickness="1.5" StrokeDashArray="6 4" />
                                        <TextBlock Canvas.Left="48" Canvas.Top="27"
                                                   Text="A"
                                                   Foreground="#111827"
                                                   FontSize="17"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Canvas.Left="528" Canvas.Top="27"
                                                   Text="B"
                                                   Foreground="#111827"
                                                   FontSize="17"
                                                   FontWeight="SemiBold" />
                                        <Polygon Points="54,58 78,58 66,38"
                                                 Stroke="#111827"
                                                 Fill="#D7ECEB"
                                                 StrokeThickness="1.5" />
                                        <Polygon Points="508,58 532,58 520,38"
                                                 Stroke="#111827"
                                                 Fill="#D7ECEB"
                                                 StrokeThickness="1.5" />

                                        <Line X1="66" Y1="96" X2="520" Y2="96"
                                              Stroke="#111827" StrokeThickness="1.5" />
                                        <Line X1="66" Y1="164" X2="520" Y2="164"
                                              Stroke="#111827" StrokeThickness="1.5" />
                                        <Line X1="66" Y1="232" X2="520" Y2="232"
                                              Stroke="#111827" StrokeThickness="1.5" />
                                        <TextBlock Canvas.Left="40" Canvas.Top="86"
                                                   Text="0"
                                                   Foreground="#111827"
                                                   FontSize="13" />
                                        <TextBlock Canvas.Left="40" Canvas.Top="154"
                                                   Text="0"
                                                   Foreground="#111827"
                                                   FontSize="13" />
                                        <TextBlock Canvas.Left="40" Canvas.Top="222"
                                                   Text="0"
                                                   Foreground="#111827"
                                                   FontSize="13" />
                                        <TextBlock Canvas.Left="62" Canvas.Top="270"
                                                   Text="0"
                                                   Foreground="#111827"
                                                   FontSize="13" />
                                        <TextBlock Canvas.Left="514" Canvas.Top="270"
                                                   Text="L"
                                                   Foreground="#111827"
                                                   FontSize="13" />

                                        <Ellipse Canvas.Left="540" Canvas.Top="79"
                                                 Width="34" Height="34"
                                                 Stroke="#111827"
                                                 Fill="#EAFBFA"
                                                 StrokeThickness="1.5" />
                                        <TextBlock Canvas.Left="550" Canvas.Top="84"
                                                   Text="V"
                                                   Foreground="#20C9B0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Canvas.Left="578" Canvas.Top="88"
                                                   Text="kN"
                                                   Foreground="#111827"
                                                   FontSize="12" />

                                        <Ellipse Canvas.Left="540" Canvas.Top="147"
                                                 Width="34" Height="34"
                                                 Stroke="#111827"
                                                 Fill="#EAFBFA"
                                                 StrokeThickness="1.5" />
                                        <TextBlock Canvas.Left="549" Canvas.Top="152"
                                                   Text="M"
                                                   Foreground="#E11D48"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Canvas.Left="578" Canvas.Top="156"
                                                   Text="kNm"
                                                   Foreground="#111827"
                                                   FontSize="12" />

                                        <Ellipse Canvas.Left="540" Canvas.Top="215"
                                                 Width="34" Height="34"
                                                 Stroke="#111827"
                                                 Fill="#EAFBFA"
                                                 StrokeThickness="1.5" />
                                        <TextBlock Canvas.Left="550" Canvas.Top="220"
                                                   Text="Q"
                                                   Foreground="#2563EB"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Canvas.Left="578" Canvas.Top="224"
                                                   Text="kN"
                                                   Foreground="#111827"
                                                   FontSize="12" />

                                        <ItemsControl ItemsSource="{Binding InternalForceDiagrams}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas>
                                                        <Polygon Points="{Binding AreaPoints}"
                                                                 Fill="{Binding Stroke}"
                                                                 Opacity="0.10" />
                                                        <ItemsControl ItemsSource="{Binding Hatches}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Line X1="{Binding X}"
                                                                          X2="{Binding X}"
                                                                          Y1="{Binding Y1}"
                                                                          Y2="{Binding Y2}"
                                                                          Stroke="#111827"
                                                                          StrokeThickness="1"
                                                                          Opacity="0.75" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Polyline Points="{Binding Points}"
                                                                  Stroke="{Binding Stroke}"
                                                                  StrokeThickness="2.5"
                                                                  StrokeLineJoin="Round" />
                                                        <Ellipse Canvas.Left="{Binding MaxMarkerX}"
                                                                 Canvas.Top="{Binding MaxMarkerY}"
                                                                 Width="7"
                                                                 Height="7"
                                                                 Fill="{Binding Stroke}"
                                                                 Stroke="#FFFFFF"
                                                                 StrokeThickness="1" />
                                                        <Border Canvas.Left="{Binding MaxLabelX}"
                                                                Canvas.Top="{Binding MaxLabelY}"
                                                                Background="#EAFBFA"
                                                                BorderBrush="{Binding Stroke}"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="4,1">
                                                            <TextBlock Text="{Binding MaxLabelText}"
                                                                       Foreground="{Binding Stroke}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <Ellipse Canvas.Left="{Binding MinMarkerX}"
                                                                 Canvas.Top="{Binding MinMarkerY}"
                                                                 Width="7"
                                                                 Height="7"
                                                                 Fill="{Binding Stroke}"
                                                                 Stroke="#FFFFFF"
                                                                 StrokeThickness="1" />
                                                        <Border Canvas.Left="{Binding MinLabelX}"
                                                                Canvas.Top="{Binding MinLabelY}"
                                                                Background="#EAFBFA"
                                                                BorderBrush="{Binding Stroke}"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="4,1">
                                                            <TextBlock Text="{Binding MinLabelText}"
                                                                       Foreground="{Binding Stroke}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Công cụ ETABS" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Đọc nội lực tại vị trí |M3|max của dầm đang chọn."
                                   Margin="0,3,0,8"
                                   Style="{StaticResource CaptionStyle}" />
                        <Border Background="#15171D"
                                BorderBrush="{StaticResource PanelLineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Dầm đang chọn"
                                           Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding SelectedFrameText}"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding SelectedFrameText}" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="38" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding ConnectEtabsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="8,5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource IconTextStyle}" />
                                    <TextBlock Text="Kết nối" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding DisconnectEtabsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="8,5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource IconTextStyle}" />
                                    <TextBlock Text="Ngắt" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="2"
                                    Grid.ColumnSpan="3"
                                    Command="{Binding ReadInternalForcesCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextStyle}" />
                                    <TextBlock Text="Đọc nội lực dầm" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Background="#15171D"
                                BorderBrush="{Binding StatusBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9"
                                Margin="0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{Binding StatusBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding ConnectionStatus}"
                                               Foreground="{Binding StatusBrush}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding ConnectionMessage}"
                                           Margin="0,7,0,0"
                                           MaxHeight="58"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding ModelName}"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ModelPath}"
                                           Margin="0,3,0,0"
                                           Style="{StaticResource CaptionStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ModelPath}" />
                                <TextBlock Text="{Binding EtabsVersion, StringFormat=Phiên bản ETABS: {0}}"
                                           Margin="0,5,0,0"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource CardStyle}"
                        Padding="14"
                        MinHeight="246">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Dữ liệu nhận" Style="{StaticResource SectionTitleStyle}" />
                        <Border Visibility="{Binding ForceResultEmptyVisibility}"
                                Grid.Row="1"
                                Background="#15171D"
                                BorderBrush="{StaticResource PanelLineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Chưa đọc nội lực"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Sau khi đọc ETABS, chương trình sẽ hiển thị |M3|max cùng V2, V3 và P tại đúng vị trí đó."
                                           Margin="0,4,0,0"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1"
                                      Visibility="{Binding ForceResultListVisibility}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="198"
                                      Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding InternalForces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource PanelLineBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="9"
                                                        Height="24"
                                                        Background="{Binding BarBrush}"
                                                        CornerRadius="3"
                                                        Margin="0,0,9,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Direction}"
                                                               Style="{StaticResource CaptionStyle}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ValueText}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>
        </Grid>
</UserControl>
