<UserControl x:Class="LTUDTXD_HUCE_01_LEMANHLINH_0318867_67TH3.Views.EtabsSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="AnimatedBarStyle" TargetType="Border">
            <Setter Property="Width" Value="50" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="RenderTransformOrigin" Value="0.5,1" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.25" To="1"
                                             Duration="0:0:0.42" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="0" To="1"
                                             Duration="0:0:0.52"
                                             DecelerationRatio="0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.035" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nguồn nội lực từ ETABS" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding Summary}"
                                       Margin="0,3,0,0"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="14"
                                Padding="11,5"
                                VerticalAlignment="Top">
                            <TextBlock Text="ETABS"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding InternalForces}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="118" Height="356" Margin="0,0,18,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="260" />
                                            <RowDefinition Height="62" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding ValueText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Grid Grid.Row="1">
                                            <Border Width="50"
                                                    Background="#26312F"
                                                    CornerRadius="6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Stretch" />
                                            <Border Height="{Binding BarHeight}"
                                                    Background="{Binding BarBrush}"
                                                    Style="{StaticResource AnimatedBarStyle}" />
                                        </Grid>
                                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Direction}"
                                                       HorizontalAlignment="Center"
                                                       Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Công cụ ETABS" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Kết nối và đọc nội lực thiết kế."
                                   Margin="0,3,0,12"
                                   Style="{StaticResource CaptionStyle}" />
                        <Button Command="{Binding ConnectEtabsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE774;" Style="{StaticResource IconTextStyle}" />
                                <TextBlock Text="Kết nối ETABS" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DisconnectEtabsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE711;" Style="{StaticResource IconTextStyle}" />
                                <TextBlock Text="Ngắt kết nối" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ReadInternalForcesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextStyle}" />
                                <TextBlock Text="Đọc dữ liệu" />
                            </StackPanel>
                        </Button>
                        <Border Background="#15171D"
                                BorderBrush="{Binding StatusBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{Binding StatusBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding ConnectionStatus}"
                                               Foreground="{Binding StatusBrush}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding ConnectionMessage}"
                                           Margin="0,7,0,0"
                                           Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding ModelName}"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ModelPath}"
                                           Margin="0,3,0,0"
                                           Style="{StaticResource CaptionStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ModelPath}" />
                                <TextBlock Text="{Binding EtabsVersion, StringFormat=Phiên bản ETABS: {0}}"
                                           Margin="0,5,0,0"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Dữ liệu nhận" Style="{StaticResource SectionTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding InternalForces}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource PanelLineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="10"
                                                    Height="26"
                                                    Background="{Binding BarBrush}"
                                                    CornerRadius="3"
                                                    Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Direction}"
                                                           Style="{StaticResource CaptionStyle}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ValueText}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
